API_TOKEN=replace-with-a-long-random-secret
DATA_DIR=data
POLL_SECONDS=300
WORKER_ENABLED=true
# External transmission is disabled by default. Enable only after reviewing provider terms.
ALLOW_EXTERNAL_LLM=false
LLM_API_KEY=
LLM_MODEL=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Start with recent mail; subsequent polls scan this window and deduplicate by UIDVALIDITY/UID.
IMAP_LOOKBACK_DAYS=30
PAPERLESS_URL=
PAPERLESS_TOKEN=
NTFY_URL=
NTFY_TOKEN=
MESSENGER_SECRET=
LLM_PROVIDER=openai
# Confirm suitable billing/contract settings before sending sensitive data to Gemini.
GEMINI_PAID_CONFIRMED=false
# ioBroker: API endpoint, not the admin UI on port 8081
IOBROKER_URL=
IOBROKER_API=simple
IOBROKER_USER=
IOBROKER_PASSWORD=
IOBROKER_TOKEN=
IOBROKER_PATTERNS=*.connected,*.reachable,*.online,*.UNREACH
IOBROKER_ENABLED=false
# off / important / digest; automatic messages are batched and rate-limited
NTFY_MODE=important
NTFY_INTERVAL_SECONDS=3600
# Separate interactive chat consent from automatic background analysis
CHAT_LLM_ENABLED=false
# Vollständige lokale Textindexierung des noch lesbaren E-Mail-Altbestands
IMAP_ARCHIVE_ENABLED=true
IMAP_ARCHIVE_ALL_FOLDERS=true
# Eine vollständige Topic-URL pro Zeile (dotenv unterstützt mehrzeilige Werte)
NTFY_HISTORY_URLS=
NTFY_HISTORY_ENABLED=true
# Exakte HTTPS-Origin des eigenen Reverse-Proxys; leer = ausschließlich lokal
PUBLIC_ORIGIN=

# Local-only audio transcription; installer can disable it with --no-speech
SPEECH_ENABLED=true
# Managed installs set BUTLER_ENV_FILE and DATA_DIR via systemd, not this file.

# Öffentliche Zusatzdaten: pro Verbindung aktivieren; Ort kommt vom fragenden Gerät.
WEATHER_ENABLED=false
HOLIDAYS_ENABLED=false
